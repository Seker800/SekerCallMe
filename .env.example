# Public address other Codex machines use. init.sh replaces this automatically.
LAN_HOST=192.168.1.10
MCP_PORT=3010
NTFY_PORT=8080

# Generated by scripts/init.sh. Do not reuse these placeholders.
MCP_ACCESS_TOKEN=replace-with-a-long-random-token
NTFY_USER=codex
NTFY_PASSWORD=replace-with-a-long-random-password
NTFY_TOPIC=replace-with-a-random-topic

# Optional macOS speech settings.
SEKER_VOICE=Tingting
SEKER_VOICE_RATE=170
SEKER_SPEECH_PROVIDER=auto
SEKER_VOICE_DEDUP_SECONDS=120

# Optional local Qwen3-TTS settings. The service is loopback-only.
SEKER_QWEN_TTS_PORT=8785
SEKER_QWEN_TTS_URL=http://127.0.0.1:8785/v1/tts
SEKER_QWEN_TTS_VOICE=vivian
SEKER_QWEN_TTS_LANGUAGE=Chinese
SEKER_QWEN_TTS_RATE=1.0
SEKER_QWEN_TTS_TIMEOUT=30
SEKER_QWEN_TTS_STARTUP_TIMEOUT=30
SEKER_QWEN_TTS_THREADS=8
SEKER_QWEN_TTS_IDLE_SECONDS=1200
